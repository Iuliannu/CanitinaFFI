digraph CantinaFFI {
  graph [rankdir=BT, nodesep=0.45, ranksep=0.7, fontname="Helvetica", dpi=150, splines=true, pad=0.3];
  node  [shape=record, fontname="Helvetica", fontsize=10, style=filled, fillcolor="#FFFFFF", color="#333333"];
  edge  [fontname="Helvetica", fontsize=9, color="#333333"];

  Produs [label="{Produs|-contor: int \{static\}\l-id: int \{final\}\l-denumire: String\l-pret: double\l-stoc: int\l|+pretFinal(): double\l+areStoc(int): boolean\l+scadeStoc(int): void\l+setPret(double): void\l+equals(Object): boolean\l+toString(): String\l}", fillcolor="#E8F0FE"];

  Shaorma [label="{Shaorma|-picanterie: Picanterie\l|+pretFinal(): double\l+toString(): String\l}"];
  ShaormaVegana [label="{ShaormaVegana|-cuHummus: boolean\l|+pretFinal(): double\l+toString(): String\l}"];
  Garnitura [label="{Garnitura|-portie: Portie\l|+pretFinal(): double\l+toString(): String\l}"];
  Bautura [label="{Bautura|-volumMl: int\l|+pretFinal(): double\l+toString(): String\l}"];
  MeniuCombo [label="{MeniuCombo|-componente: List\<Produs\>\l|+pretFinal(): double\l+getStoc(): int\l+scadeStoc(int): void\l+toString(): String\l}", fillcolor="#FFF4D6"];

  Picanterie [label="{«enum» Picanterie|FARA, MEDIE, PICANTA, FOARTE_PICANTA\l|-supliment: double\l-eticheta: String\l}", fillcolor="#EAF6EA"];
  Portie [label="{«enum» Portie|MICA, NORMALA, DUBLA\l|-coeficient: double\l-grame: int\l}", fillcolor="#EAF6EA"];

  Comanda [label="{Comanda|-linii: List\<LinieComanda\>\l-inchisa: boolean\l|+adauga(Produs, int): boolean\l+subtotal(): BigDecimal\l+reducereDuoShaorma(): BigDecimal\l+total(): BigDecimal\l}", fillcolor="#FDE8E8"];
  LinieComanda [label="{LinieComanda|-produs: Produs\l-cantitate: int\l|~LinieComanda(Produs, int)\l+subtotal(): BigDecimal\l}", fillcolor="#FDE8E8"];
  Bon [label="{Bon|-contor: int \{static\}\l-numar: int \{final\}\l-comanda: Comanda\l|+areCadou(): boolean\l+getTotal(): BigDecimal\l+toString(): String\l}", fillcolor="#FDE8E8"];
  Meniu [label="{Meniu|-denumire: String\l-produse: List\<Produs\>\l|+adaugaProdus(Produs): void\l}"];
  Stand [label="{Stand|-denumire: String\l-concept: String\l-produse: List\<Produs\>\l-meniuri: List\<Meniu\>\l|+shaormaExpress(): Stand \{static\}\l}"];
  ZiLaStand [label="{ZiLaStand|-bonuri: List\<Bon\>\l|+main(String[]): void\l}"];

  // mostenire (triunghi gol)
  Shaorma -> Produs [arrowhead=onormal];
  ShaormaVegana -> Shaorma [arrowhead=onormal];
  Garnitura -> Produs [arrowhead=onormal];
  Bautura -> Produs [arrowhead=onormal];
  MeniuCombo -> Produs [arrowhead=onormal];

  // asocieri cu enum
  Shaorma -> Picanterie [arrowhead=vee, style=dashed, label="foloseste"];
  Garnitura -> Portie [arrowhead=vee, style=dashed, label="foloseste"];

  // compozitie (romb plin)
  Comanda -> LinieComanda [dir=back, arrowtail=diamond, arrowhead=none, label="1..*"];

  // agregare (romb gol)
  LinieComanda -> Produs [arrowhead=vee, label="refera"];
  Bon -> Comanda [dir=back, arrowtail=odiamond, arrowhead=none, label="1"];
  Meniu -> Produs [dir=back, arrowtail=odiamond, arrowhead=none, label="0..*"];
  MeniuCombo -> Produs [dir=back, arrowtail=odiamond, arrowhead=none, label="2..*", constraint=false];
  Stand -> Produs [dir=back, arrowtail=odiamond, arrowhead=none, label="0..*", constraint=false];
  Stand -> Meniu [dir=back, arrowtail=odiamond, arrowhead=none, label="0..*", constraint=false];
  ZiLaStand -> Bon [dir=back, arrowtail=odiamond, arrowhead=none, label="0..*", constraint=false];
}
